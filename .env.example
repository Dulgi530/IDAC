# ── 데이터 소스 ────────────────────────────────────────────────
# live   : 실제 외부 API 호출 (운영)
# fixture: 저장된 스냅샷으로 동작 (오프라인/개발/데모)
IDAC_DATA_SOURCE=fixture

# ── 코인마켓캡 (3.1) ──────────────────────────────────────────
COINMARKETCAP_API_KEY=
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# ── 쟁글 Xangle (3.2) ─────────────────────────────────────────
# 국내 공시 플랫폼. 재단이 지속적으로 활동 중인지(2.3) 판정하는 근거.
XANGLE_API_KEY=
XANGLE_BASE_URL=https://api.xangle.io

# ── CertiK Skynet (보조 지표) ─────────────────────────────────
SKYNET_API_KEY=
SKYNET_BASE_URL=https://api.skynet.certik.com

# ── 관리자/퍼블릭 도메인 분리 (요구사항 4) ─────────────────────
# ADMIN_HOST 로 접속했을 때만 리포트 생성 UI/API가 열린다.
ADMIN_HOST=admin.localhost:3000
# 리포트 생성 API 호출에 필요한 토큰 (x-idac-admin-token 헤더)
ADMIN_TOKEN=

# ── 리포트 저장 경로 ──────────────────────────────────────────
IDAC_REPORT_DIR=./data/reports
